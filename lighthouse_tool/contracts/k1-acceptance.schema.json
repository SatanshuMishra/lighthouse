{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "harness-redesign/k1-acceptance.schema.json",
  "title": "K1 acceptance line",
  "description": "One acceptance line of a criterion in an interphase record. command runs from the repository root: exit 0 pass, 1 fail, any other exit could-not-run.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "kind", "surface", "command", "pass"],
  "properties": {
    "id": {"type": "string", "pattern": "^C[0-9]+\\.[0-9]+$"},
    "kind": {"enum": ["exact", "judged"]},
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "target"],
      "properties": {
        "family": {"enum": ["cli", "http", "browser", "desktop", "mobile", "agent", "library", "data"]},
        "target": {"type": "string", "minLength": 1}
      }
    },
    "command": {"type": "string", "minLength": 1},
    "pass": {"type": "string", "minLength": 1},
    "rubric": {"type": "string", "minLength": 1},
    "trials": {"const": 3}
  },
  "if": {"properties": {"kind": {"const": "judged"}}},
  "then": {"required": ["rubric", "trials"]},
  "else": {"not": {"anyOf": [{"required": ["rubric"]}, {"required": ["trials"]}]}}
}
