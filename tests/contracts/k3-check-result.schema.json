{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "harness-redesign/k3-check-result.schema.json",
  "title": "K3 check result",
  "description": "One check's result from any runner. Verdicts read only these, never model-written status fields.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "check_id",
    "commit",
    "surface",
    "status",
    "evidence",
    "seconds",
    "runner"
  ],
  "properties": {
    "check_id": {
      "type": "string",
      "pattern": "^C[0-9]+\\.[0-9]+$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "surface": {
      "$ref": "k1-acceptance.schema.json#/properties/surface"
    },
    "status": {
      "enum": [
        "pass",
        "fail",
        "could-not-run"
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "seconds": {
      "type": "number",
      "minimum": 0
    },
    "runner": {
      "type": "string",
      "minLength": 1
    }
  },
  "if": {
    "properties": {
      "status": {
        "enum": [
          "pass",
          "fail"
        ]
      }
    }
  },
  "then": {
    "properties": {
      "evidence": {
        "type": "array",
        "minItems": 1
      }
    }
  }
}
